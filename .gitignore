# Build artifact -- rebuilt by tools/build_zip.py
/terracotta.zip

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# Working scene files and renders from dev sessions live at the repo root;
# the addon's bundled datablocks (terracotta/*.blend) stay tracked.
/*.blend
/*.blend1
/*.png

# Pre-package prototypes, superseded by terracotta/. Kept on disk for
# reference, out of history.
/tripo.py
/meshtools.py
/tripo_panel.py

# Never any key material (keys live in Blender preferences, env vars, or
# ~/.tripo_key -- never in this repo).
*.key

# Upstream blender-mcp addon (MIT, dev-only): fetch from
# github.com/ahujasid/blender-mcp rather than vendoring it here.
/addon.py
/*.mov
